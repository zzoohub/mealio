{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "zzoo.origin@gmail.com",
        "ascAppId": "6758864658",
        "appleTeamId": "6VMN7W3K93"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account-play-store-api.json",
        "track": "production"
      }
    }
  }
}
