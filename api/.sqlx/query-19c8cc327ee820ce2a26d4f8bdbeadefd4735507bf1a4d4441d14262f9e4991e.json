  "db_name": "PostgreSQL",
  "query": "SELECT ei.id, ei.entry_id, ei.ingredient_id, i.name as ingredient_name, ei.amount, ei.unit, ei.created_at\n             FROM entry_ingredients ei\n             JOIN ingredients i ON i.id = ei.ingredient_id\n             WHERE ei.entry_id = $1\n             ORDER BY ei.created_at",
