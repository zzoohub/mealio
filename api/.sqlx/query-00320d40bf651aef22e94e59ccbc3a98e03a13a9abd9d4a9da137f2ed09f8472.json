  "db_name": "PostgreSQL",
  "query": "SELECT id, name, category, created_at FROM ingredients\n             WHERE ($1::text IS NULL OR name % $1 OR name ILIKE '%' || $1 || '%')\n             ORDER BY CASE WHEN $1::text IS NOT NULL THEN similarity(name, $1) END DESC NULLS LAST, name\n             LIMIT $2 OFFSET $3",
