  "query": "SELECT meal_type as \"meal_type: MealType\", COUNT(*)::int8 as \"count!\"\n         FROM diary_entries\n         WHERE user_id = $1 AND deleted_at IS NULL\n         AND ($2::date IS NULL OR eaten_at::date >= $2)\n         AND ($3::date IS NULL OR eaten_at::date <= $3)\n         GROUP BY meal_type\n         ORDER BY COUNT(*) DESC",
